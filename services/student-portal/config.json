{
  "kafka": {
    "enabled": true,
    "bootstrap_servers": "kafka:29092",
    "topics": ["order_events", "fulfilment.events", "order_events_dlq"],
    "readonly": true
  },
  "redis": {
    "enabled": true,
    "url": "redis://redis:6379/0",
    "readonly": true,
    "allowed_keys_prefix": ["stock:", "event:", "retry:"]
  },
  "postgres": {
    "enabled": true,
    "url": "postgresql://fulfilbox:fulfilbox@postgres:5432/fulfilbox",
    "max_rows": 100,
    "allowed_tables": ["orders", "events"],
    "blocked_keywords": ["DROP", "DELETE", "UPDATE", "INSERT", "TRUNCATE", "ALTER", "CREATE", "GRANT"]
  },
  "sentry": {
    "enabled": false,
    "dsn": "",
    "org_slug": ""
  },
  "kubernetes": {
    "enabled": true,
    "kubeconfig_path": "",
    "dashboard_url": "http://localhost:8001/api/v1/namespaces/kubernetes-dashboard/services/https:kubernetes-dashboard:/proxy/"
  },
  "rate_limit": {
    "max_requests_per_minute": 60
  }
}
